FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY CMakeLists.txt LICENSE NOTICE ./
COPY include include
COPY src src
COPY app app
COPY tests tests
COPY third_party third_party
COPY examples examples
COPY datasets datasets
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DVANTAGE_CUDA=OFF && cmake --build build -j 4 && ctest --test-dir build --output-on-failure
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/vantage
COPY --from=build /src/build/niryukti build/niryukti
COPY --from=build /src/build/libniryukti_c.so build/libniryukti_c.so
COPY python python
ENV PYTHONPATH=/opt/vantage/python
ENV NIRYUKTI_BINARY=/opt/vantage/build/niryukti
ENV NIRYUKTI_LIBRARY=/opt/vantage/build/libniryukti_c.so
COPY dashboard dashboard
COPY benchmark benchmark
COPY examples examples
COPY datasets datasets
COPY docs docs
COPY LICENSE NOTICE ./
RUN useradd --create-home solver && mkdir -p results && chown solver:solver results
USER solver
ENTRYPOINT ["/opt/vantage/build/niryukti"]
CMD ["devices"]
