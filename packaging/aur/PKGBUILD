# Local recipe; not published to AUR or an official Arch repository.
pkgname=niryukti-git
pkgver=0.2.0.r0
pkgrel=1
pkgdesc='Independent sparse numerical optimization engine'
arch=('x86_64' 'aarch64')
url='https://github.com/shoaib2000857/Vantage'
license=('AGPL-3.0-only')
depends=('gcc-libs' 'glibc')
makedepends=('git' 'cmake' 'gcc' 'make')
provides=('niryukti')
conflicts=('niryukti')
source=('vantage::git+https://github.com/shoaib2000857/Vantage.git#branch=main')
sha256sums=('SKIP')
pkgver() {
  cd "$srcdir/vantage"
  printf '0.2.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
build() {
  cmake -S "$srcdir/vantage" -B "$srcdir/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF -DVANTAGE_OPENMP=OFF
  cmake --build "$srcdir/build" --parallel 2
}
package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
